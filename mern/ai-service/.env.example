# LostLink AI inference service - copy to .env to override any default.
# Every value here is also read from the real environment, so a launcher script
# or container can set them instead.

# ---- service ----
HOST=127.0.0.1
PORT=8100
LOG_LEVEL=INFO

# ---- device ----
# auto | cuda | cpu. "auto" uses cuda when torch reports a GPU.
DEVICE=auto

# ---- boot warm-up ----
# Models load lazily so /health answers within a second. On a CPU box the first
# item scan then pays the whole load (tens of seconds) while a user waits.
# WARMUP_ON_BOOT preloads them in a background thread instead.
WARMUP_ON_BOOT=1
# "*" preloads every provider. The default preloads only the scan path and
# leaves the two 500M-parameter text models (reranker) and the VLM lazy, since
# they are used later, at match time.
WARMUP_PROVIDERS=detector,siglip,ocr,bge_m3

# ---- vector store ----
# Tier 1: a Qdrant server. Tier 2: Qdrant's local on-disk engine at
# QDRANT_LOCAL_PATH, used automatically when the server is unreachable - this
# keeps embeddings across restarts with nothing to install. Tier 3 (in-memory)
# only happens if the local engine cannot start either.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lostlink_vectors
QDRANT_LOCAL_PATH=storage/qdrant-local
ALLOW_VECTOR_FALLBACK=true

# ---- vision-language model (optional) ----
# Attributes (brand, material, visible marks) are strongest when a VLM answers
# them. It is OpenAI-compatible, so point VLM_BASE_URL at any local or hosted
# server exposing /v1/chat/completions (vLLM, Ollama, LM Studio, an API).
# Left empty, the service says so on every response and falls back to
# detection + OCR + colour sampling instead of inventing attributes.
VLM_BASE_URL=
VLM_API_KEY=
QWEN_MODEL=qwen3-vl
VLM_TIMEOUT_SECONDS=30

# ---- models ----
YOLO_MODEL=yolo26n.pt
SIGLIP_MODEL=google/siglip2-base-patch16-224
BGE_TEXT_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- live camera ingest (RTSP) ----
# OFF by default, and that default is deliberate: subscribing to an
# organisation's camera network is a deployment decision with privacy and
# network consequences. While off, a live-camera request is answered with an
# explicit "not enabled" reason instead of failing obscurely.
# Object tracking only - no frame is ever passed to a face-recognition model.
RTSP_ENABLED=false
# Comma-separated host allowlist. Empty means any reachable RTSP host may be
# requested, which /health reports as a warning.
RTSP_ALLOWED_HOSTS=
# Hard bounds so one request cannot hold a worker open on an endless stream.
RTSP_MAX_SECONDS=60
RTSP_MAX_FRAMES=120

# ---- uploads ----
STORAGE_DIR=storage
MAX_UPLOAD_BYTES=5242880

# ---- CORS (the Node API and the Vite dev server) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080
