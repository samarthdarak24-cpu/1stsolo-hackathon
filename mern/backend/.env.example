# Backend environment variables for deployment
NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-frontend-domain.com
DATABASE_URL=postgresql://username:password@localhost:5432/lostlink
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=https://your-ai-service-domain.com
AI_ENABLED=true
MAIL_DRIVER=off
MAIL_FROM=noreply@yourdomain.com
DATA_MODE=postgres
PGSSL=false
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=40
REDIS_URL=
STORAGE_DRIVER=auto
STORAGE_PUBLIC_BASE_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=uploads
